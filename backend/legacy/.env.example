# ============================================
# Permedjat Backend - Environment Variables
# Copy this file to config/env.php and fill in values
# ============================================

# --- Database ---
DB_DSN=mysql:host=localhost;port=3306;dbname=permedjat;charset=utf8mb4
DB_USER=root
DB_PASS=root

# --- CORS ---
# Comma-separated origins, or * for all. Leave empty to disable CORS.
CORS_ALLOWED_ORIGINS=

# --- Firebase ---
FIREBASE_CREDENTIALS_PATH=../core/firebase_credentials.json

# --- JWT Secret (for admin sessions) ---
JWT_SECRET=your_random_64_char_hex_secret_here

# --- OTP Configuration ---
OTP_HMAC_SECRET=your_random_64_char_hex_secret_here
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_MAX=3
OTP_LOCKOUT_MINUTES=15

# --- WhatsApp OTP ---
WASENDER_API_KEY=your_wasender_api_key_here
WASENDER_API_URL=https://wasenderapi.com/api/send-message

# --- File Upload ---
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf

# --- Paymob Payment ---
PAYMOB_API_KEY=your_paymob_api_key_here
PAYMOB_INTEGRATION_ID=your_integration_id

# --- S3 Storage ---
S3_KEY=your_s3_key
S3_SECRET=your_s3_secret
S3_BUCKET=permedjat-documents
S3_REGION=me-south-1

# --- SMTP (outgoing email: verification, alerts) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@permedjatapp.com
SMTP_SECURE=tls

# --- Branding (used in transactional emails) ---
APP_NAME=Permedjat
# Absolute URL to your logo (PNG/JPG hosted publicly). Leave empty to show the app name as text.
APP_LOGO_URL=
APP_BRAND_COLOR=#2E7D6B
