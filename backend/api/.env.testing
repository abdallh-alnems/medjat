APP_NAME=Medjat
APP_ENV=testing
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_KEY=base64:zqbgYqrTBhnI0y0gTQ7yqNCwPHCRVUZ4rBSLNy8j1Uc=
APP_DEBUG=true
APP_URL=http://localhost

# Tests run against real MySQL rather than in-memory SQLite, because the schema
# leans on things SQLite does not have — ENUM columns above all, and the suite
# exists partly to catch values written that the column does not accept. Build
# it with `php artisan migrate`. Each test opens a transaction and rolls back,
# so the data survives the run unchanged.
#
# Local defaults are MAMP's. CI rewrites the host and port for its own service
# container — which is why these live here and not in phpunit.xml, where they
# would take precedence over the environment and silently ignore CI.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=8889
DB_DATABASE=medjat_laravel_test
DB_USERNAME=root
DB_PASSWORD=root

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
BCRYPT_ROUNDS=4
