APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
# Permedjat
#
# Everything below is specific to this application. The live server's file is
# written by hand, so this list is the reference for what it must contain.
# ─────────────────────────────────────────────────────────────────────────────

# The HTTP Basic credential every published app bundle sends. Leave both empty
# in development: unset disables the gate, and a half-set pair would make every
# request 401 with nothing to point at. Required in production.
SECURITY_USER=
SECURITY_KEY=

# The shared secret the scheduled jobs authenticate with. Unset refuses every
# cron request rather than accepting one — these endpoints terminate employees
# and delete photographs.
CRON_SECRET=

# Browser clients only; the apps and the terminals never send an Origin. Empty
# denies every cross-origin request, which is the right default for an API
# holding payroll. Comma-separated, no trailing slash.
# e.g. https://app.permedjatapp.com,https://permedjatapp.com
CORS_ALLOWED_ORIGINS=

# Service-account JSON for FCM, Remote Config and token verification. Absent
# means anything touching Firebase fails loudly; the read gates still fail open.
FIREBASE_CREDENTIALS_PATH=

# Where the management web app lives, for links the admin panel hands an
# operator — impersonation among them.
CENTRAL_WEB_URL=https://app.permedjatapp.com

# Store listings for the two apps. An empty one is left out of the deep-link
# landing pages entirely — a dead link is worse than none.
STORE_URL_EMPLOYEE_ANDROID=https://play.google.com/store/apps/details?id=com.khawarizmie.permedjat
STORE_URL_EMPLOYEE_IOS=
STORE_URL_CENTRAL_ANDROID=https://play.google.com/store/apps/details?id=com.khawarizmie.permedjat_central
STORE_URL_CENTRAL_IOS=

# Must be a domain hosting the App Links / Universal Links association files,
# or a join link opens a web page instead of the app.
APP_JOIN_BASE_URL=https://permedjatapp.com

# Our own branded page for Firebase auth actions, and the logo the emails use.
APP_ACTION_URL=https://permedjatapp.com/auth-action.html
APP_LOGO_URL=https://permedjatapp.com/email-logo.png

# Salts the kiosk employee codes. Changing it invalidates every existing one,
# so it is set once per environment and left alone.
KIOSK_CODE_PEPPER=

# Payslips, documents and captures. Served only through authenticated PHP —
# never hand a client a path under here.
UPLOADS_PATH=
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf
UPLOAD_MAX_SIZE=5242880

# Requests per minute per IP, before throttling. High on purpose: a branch
# punching in at shift change shares one NAT address, so this stops a runaway
# client rather than shaping normal traffic. Must match the reasoning in
# config/permedjat.php — this file said 120 while that one said 600.
API_RATE_LIMIT=600

# Proxies allowed to declare the client's address. Empty is correct behind the
# current nginx, which rewrites REMOTE_ADDR from CF-Connecting-IP before PHP
# runs. Set it only for a proxy that does not do that, and name the proxy's
# addresses — never '*', which lets any caller claim any IP.
TRUSTED_PROXIES=

# The store-review account: one phone and code that sign straight in without
# consuming an activation row. Inert unless all three are set, which they are
# not in production.
REVIEW_DEMO_PHONE=
REVIEW_DEMO_CODE=
REVIEW_DEMO_TOKEN=
