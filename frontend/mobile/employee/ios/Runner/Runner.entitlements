<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>https://permedjat.com</string>
	</array>
	<!-- Access WiFi Information: lets the app read the connected access point's
	     BSSID for the wifi_gps attendance method. iOS also requires location
	     authorisation to return a real value, which the app already holds for
	     the GPS geofence. -->
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
</dict>
</plist>
