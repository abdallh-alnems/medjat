# Copy to `.env` before running. The real file is gitignored and must never be
# committed — it carries the backend's shared Basic credentials.
#
#   cp .env.example .env
#   flutter run

# Backend root, no trailing slash.
#
#   local (MAMP):  http://localhost:8888
#                  No /backend_medjet suffix — MAMP's document root already IS
#                  backend_medjet, and adding it 404s every request.
#                  On a physical tablet, forward the port first:
#                      adb reverse tcp:8888 tcp:8888
#
#   live:          https://api.permedjat.com/backend/api
API_HOST = "http://localhost:8888"

# Basic auth in front of the API. The same pair the other Permedjat apps use.
SECURITY_USER = ""
SECURITY_KEY = ""
