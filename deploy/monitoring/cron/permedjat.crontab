# Permedjat cron jobs — times in Africa/Cairo (server timezone). Mirrors old Hostinger crons + adds DB backup.
SHELL=/bin/bash
# leave carryover rollover (self-guards to Jan 1) — matches Hostinger 0,30 0
# && means the beacon is only sent when the script actually exited 0.
0,30 0 * * * www-data /usr/bin/php8.5 /var/www/permedjat/backend/cron/cron_leave_rollover.php >> /var/log/permedjat-cron.log 2>&1 && curl -fsS -m 10 --retry 3 https://hc-ping.com/6d95a61b-bd8f-405d-b24a-db33bae492b6 >/dev/null
# catch up unmarked absences — Hostinger 50 23
50 23 * * * www-data /usr/local/bin/permedjat-cron-absences.sh >> /var/log/permedjat-cron.log 2>&1
# daily alerts — Hostinger 0 7
0 7 * * * www-data /usr/local/bin/permedjat-cron-alerts.sh >> /var/log/permedjat-cron.log 2>&1
# DB backup (new, not on Hostinger) — 02:00, 14-day retention
0 2 * * * root /usr/local/bin/permedjat-backup.sh >> /var/log/permedjat-cron.log 2>&1
# purge expired kiosk capture images — 03:30, off-peak. Idempotent.
30 3 * * * www-data /usr/local/bin/permedjat-cron-kiosk-purge.sh >> /var/log/permedjat-cron.log 2>&1
